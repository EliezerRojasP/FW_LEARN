<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FOUR_WAYS_LEARN"
        android:usesCleartextTraffic="false">

        <activity android:name=".admin.AdminContentActivity" android:exported="false" />

        <activity android:name=".ui.AccountActivity" android:exported="false" />
        <activity android:name=".alumno.ProgresoActivity" android:exported="false" />
        <activity android:name=".admin.AdminListActivity" android:exported="false" />
        <!-- Pantalla de administración -->
        <activity
            android:name=".admin.AdminActivity"
            android:exported="false" />

        <!-- Pantalla principal del alumno -->
        <activity
            android:name=".alumno.BienvenidaActivity"
            android:exported="false" />

        <!-- Pantalla de temas -->
        <activity
            android:name=".alumno.TemasActivity"
            android:exported="false" />

        <!-- Detalle del tema -->
        <activity
            android:name=".alumno.DetalleTemaActivity"
            android:exported="false" />
        <activity
            android:name=".alumno.AprendizajeActivity"
            android:exported="false" />
        <activity
            android:name=".alumno.CursosActivity"
            android:exported="false" />
        <activity
            android:name=".alumno.CursoDetalleActivity"
            android:exported="false" />
        <activity
            android:name=".alumno.TopicosActivity"
            android:exported="false" />
        <activity
            android:name=".alumno.LeccionesActivity"
            android:exported="false" />
        <activity
            android:name=".alumno.EvaluacionActivity"
            android:exported="false" />

        <!-- Pantalla de inicio / Login -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
