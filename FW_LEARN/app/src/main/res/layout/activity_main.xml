<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/espacio_20">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/espacio_24"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/espacio_60"
            android:layout_height="@dimen/espacio_60"
            android:layout_marginEnd="@dimen/espacio_14"
            android:importantForAccessibility="no"
            android:src="@drawable/icono_marca" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_app"
            android:textColor="@color/fw_tinta"
            android:textSize="@dimen/texto_24"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/titulo_login"
        android:textColor="@color/fw_tinta"
        android:textSize="@dimen/texto_28"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_8"
        android:gravity="center"
        android:text="@string/subtitulo_login"
        android:textColor="@color/fw_apagado"
        android:textSize="@dimen/texto_17" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/espacio_176"
        android:layout_marginTop="@dimen/espacio_14"
        android:contentDescription="@string/descripcion_ilustracion_login"
        android:scaleType="fitCenter"
        android:src="@drawable/ilustracion_aprendizaje" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.FW.Tarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_20">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/campo_usuario">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_16"
                android:hint="@string/campo_contrasena"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIngresar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_20"
                android:text="@string/accion_ingresar" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_18"
                android:gravity="center"
                android:text="@string/sugerencia_cuenta_login"
                android:textColor="@color/fw_apagado"
                android:textSize="@dimen/texto_13" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>