<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/saludo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titulo_bienvenida"
        android:textColor="@color/fw_tinta"
        android:textSize="@dimen/texto_28"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_6"
        android:layout_marginBottom="@dimen/espacio_18"
        android:text="@string/titulo_cursos"
        android:textColor="@color/fw_tinta"
        android:textSize="@dimen/texto_21"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/contenedorDestacado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/espacio_10"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_8"
            android:layout_weight="1"
            android:text="@string/titulo_catalogo"
            android:textColor="@color/fw_tinta"
            android:textSize="@dimen/texto_19"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonTodosCursos"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:minWidth="0dp"
            android:padding="@dimen/espacio_6"
            android:text="@string/catalogo_todos"
            android:textSize="@dimen/texto_12" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/listaCursos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>