<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.FW.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_18"
    app:cardBackgroundColor="@color/fw_marino"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_20">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/continuar_aprendiendo"
                    android:textColor="@color/fw_sobre_marino"
                    android:textSize="@dimen/texto_14" />

                <TextView
                    android:id="@+id/tituloDestacado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_8"
                    android:textColor="@color/fw_sobre_marino"
                    android:textSize="@dimen/texto_22"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cursoDestacado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_6"
                    android:textColor="@color/fw_sobre_marino"
                    android:textSize="@dimen/texto_13" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iconoDestacado"
                android:layout_width="@dimen/espacio_66"
                android:layout_height="@dimen/espacio_66"
                android:layout_marginStart="@dimen/espacio_8"
                android:background="@drawable/fondo_insignia_admin"
                android:importantForAccessibility="no"
                android:padding="@dimen/espacio_14"
                android:src="@drawable/icono_codigo"
                app:tint="@color/fw_azul" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonContinuar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_18"
            android:text="@string/accion_continuar"
            android:textColor="@color/fw_sobre_menta"
            app:backgroundTint="@color/fw_menta" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_14"
            android:text="@string/titulo_resumen_progreso"
            android:textColor="@color/fw_sobre_marino"
            android:textSize="@dimen/texto_14"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/conteoDestacado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_6"
            android:textColor="@color/fw_sobre_marino"
            android:textSize="@dimen/texto_13" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progresoDestacado"
            android:layout_width="match_parent"
            android:layout_height="@dimen/espacio_66"
            android:layout_marginTop="@dimen/espacio_10"
            android:max="10000"
            app:indicatorColor="@color/fw_azul"
            app:trackColor="@color/fw_pista"
            app:trackCornerRadius="@dimen/espacio_4"
            app:trackThickness="@dimen/espacio_7" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>