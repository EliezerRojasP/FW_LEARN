<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.FW.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_18">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoNombre"
            style="@style/Widget.FW.Entrada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/campo_nombre_curso">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/entradaNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:textColor="@color/fw_tinta"
                android:textSize="@dimen/texto_16" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoDescripcion"
            style="@style/Widget.FW.Entrada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_14"
            android:hint="@string/campo_descripcion">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/entradaDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:textColor="@color/fw_tinta"
                android:textSize="@dimen/texto_16" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/interruptorActivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_14"
            android:minHeight="@dimen/altura_48"
            android:text="@string/campo_activo"
            android:textColor="@color/fw_tinta" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_4"
            android:text="@string/sugerencia_estado_editor"
            android:textColor="@color/fw_apagado"
            android:textSize="@dimen/texto_12" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
