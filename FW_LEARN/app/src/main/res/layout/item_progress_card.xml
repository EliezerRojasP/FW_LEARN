<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.FW.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_14"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/fw_tarjeta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_18">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconoTarjeta"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/fondo_insignia_admin"
                android:importantForAccessibility="no"
                android:padding="@dimen/espacio_10"
                android:src="@drawable/icono_codigo"
                app:tint="@color/fw_azul" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_14"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tituloCurso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fw_tinta"
                    android:textSize="@dimen/texto_18"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detalleCurso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_4"
                    android:textColor="@color/fw_apagado"
                    android:textSize="@dimen/texto_13" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="@dimen/espacio_6"
                android:importantForAccessibility="no"
                android:src="@drawable/icono_flecha"
                app:tint="@color/fw_apagado" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_14"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/etiquetaPorcentaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/espacio_12"
                android:textColor="@color/fw_tinta"
                android:textSize="@dimen/texto_14"
                android:textStyle="bold" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progresoCurso"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:max="10000"
                app:indicatorColor="@color/fw_azul"
                app:trackColor="@color/fw_pista"
                app:trackCornerRadius="4dp"
                app:trackThickness="7dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/leyendaCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_8"
            android:textColor="@color/fw_apagado"
            android:textSize="@dimen/texto_12" />

        <TextView
            android:id="@+id/estadoCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_4"
            android:textColor="@color/fw_verde"
            android:textSize="@dimen/texto_12" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>