<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tituloLeccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/fw_tinta"
        android:textSize="@dimen/texto_28"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtituloLeccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_8"
        android:layout_marginBottom="@dimen/espacio_10"
        android:text="@string/sugerencia_lectura_leccion"
        android:textColor="@color/fw_apagado"
        android:textSize="@dimen/texto_14" />

    <TextView
        android:id="@+id/estadoFinalizacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/espacio_10"
        android:textColor="@color/fw_verde"
        android:textSize="@dimen/texto_13" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/pestanasLeccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/espacio_16"
        android:background="@color/fw_fondo"
        app:tabIndicatorColor="@color/fw_azul"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/fw_azul"
        app:tabTextColor="@color/fw_apagado" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.FW.Tarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/espacio_16"
        app:cardBackgroundColor="@color/fw_tarjeta">

        <LinearLayout
            android:id="@+id/cuerpoLeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_18" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.FW.Tarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/fw_menta"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_16">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recordatorio_practica"
                android:textColor="@color/fw_sobre_menta"
                android:textSize="@dimen/texto_14" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>