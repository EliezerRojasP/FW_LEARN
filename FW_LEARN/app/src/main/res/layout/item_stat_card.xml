<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.FW.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/fw_tarjeta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_14">

        <ImageView
            android:id="@+id/iconoEstadistica"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/icono_libro"
            app:tint="@color/fw_azul" />

        <TextView
            android:id="@+id/numeroEstadistica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_10"
            android:textColor="@color/fw_tinta"
            android:textSize="@dimen/texto_24"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/etiquetaEstadistica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_4"
            android:textColor="@color/fw_apagado"
            android:textSize="@dimen/texto_12" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>