<?xml version='1.0' encoding='utf-8'?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/fw_blue_soft" />
            <stroke android:color="@color/fw_blue" android:width="2dp" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/fw_card" />
            <stroke android:color="@color/fw_border" android:width="1dp" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>