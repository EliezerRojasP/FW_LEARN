<?xml version='1.0' encoding='utf-8'?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/fw_azul_suave" />
            <stroke android:color="@color/fw_azul" android:width="2dp" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/fw_tarjeta" />
            <stroke android:color="@color/fw_borde" android:width="1dp" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>